# Dedicated local Postgres for this site. Point at the burnfire cluster
# (its own PostgreSQL instance), never at a database shared with other sites.
DATABASE_URL=postgresql://burnfire_app:password@127.0.0.1:5433/burnfire

# Resend transactional email for sign-in codes (https://resend.com → API Keys).
# When empty, sign-in codes are printed to the server console (dev only).
RESEND_API_KEY=
RESEND_FROM_EMAIL=BurnFire Community <onboarding@resend.dev>
