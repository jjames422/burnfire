# Copy to .env.local and fill in from your Supabase project's
# Settings → API page. The anon key is safe to expose in the browser —
# Row Level Security (see supabase/schema.sql) is the actual security
# boundary, not secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# From Cloudflare's dashboard → Application Security → Turnstile → your widget.
# The site key is public (safe in the browser); the secret key is NOT — it's
# only ever read server-side, in app/api/verify-turnstile/route.ts.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
