# Dedicated local Postgres for this site. Point at the burnfire cluster
# (its own PostgreSQL instance), never at a database shared with other sites.
DATABASE_URL=postgresql://burnfire_app:password@127.0.0.1:5433/burnfire

# Resend transactional email for sign-in codes (https://resend.com → API Keys).
# When empty, sign-in codes are printed to the server console (dev only).
RESEND_API_KEY=
RESEND_FROM_EMAIL=BurnFire Community <onboarding@resend.dev>

# Encrypts member email addresses at rest and keys the sign-in lookup hash.
# Generate once with:  openssl rand -base64 32
# Use the SAME value everywhere (local + production) and back it up offline:
# losing it makes stored addresses unreadable and existing accounts
# unreachable by email sign-in.
EMAIL_ENCRYPTION_KEY=

# Kingdom intelligence (docs/kingdom-intelligence.md). Server-only; never NEXT_PUBLIC_.
# Last Asylum Tracker API key (create at api.lastasylumtracker.com/account, Patreon login).
LAT_API_KEY=
# Bearer secret for POST /api/intel/cron (the host timer). At least 32 characters.
INTEL_CRON_SECRET=
# Bearer secret for GET /api/intel/reports (the community bot). At least 32 characters.
INTEL_REPORT_SECRET=
# Development only: serve SYNTHETIC TEST DATA from the fixture provider. Ignored in production.
# INTEL_FIXTURES=1
